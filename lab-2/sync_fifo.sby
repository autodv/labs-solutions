# SymbiYosys configuration for Lab 2.
#   sby -f sync_fifo.sby bmc     bounded model check, 20 cycles
#   sby -f sync_fifo.sby prove   unbounded proof (k-induction)
#   sby -f sync_fifo.sby cover   reachability of the covers
[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang sync_fifo.sv fv_sync_fifo.sv --top fv_sync_fifo
prep -top fv_sync_fifo

[files]
sync_fifo.sv
fv_sync_fifo.sv
